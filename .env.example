# Copy to .env and adjust. Everything runs locally; no paid API keys are needed.

# Local LLM served by Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window passed to Ollama (tokens). Keep modest for a 6 GB GPU.
OLLAMA_NUM_CTX=8192
# Optional lighter model for reading each transcript section (the main model still merges and
# runs every check). Leave unset to use OLLAMA_MODEL for everything. See eval/ for the trade-off.
# OLLAMA_EXTRACT_MODEL=qwen2.5:3b
# Embedding model for "Ask your meetings"
# OLLAMA_EMBED_MODEL=nomic-embed-text

# faster-whisper transcription
WHISPER_MODEL=small
# auto | cuda | cpu
WHISPER_DEVICE=auto

# Where recordings, notes and reports are saved (default: %USERPROFILE%\MeetingAssistant)
# MEETINGS_DIR=
