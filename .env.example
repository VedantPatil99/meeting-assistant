# Copy to .env and adjust. Everything runs locally; no paid API keys are needed.

# Local LLM served by Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window passed to Ollama (tokens). Keep modest for a 6 GB GPU.
OLLAMA_NUM_CTX=8192

# faster-whisper transcription
WHISPER_MODEL=small
# auto | cuda | cpu
WHISPER_DEVICE=auto
